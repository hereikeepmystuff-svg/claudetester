# Ubuntu Touch / Halium 11 port: Xiaomi Redmi Note 10 Pro (India: sweetin, global: sweet), SM7150 (sdmsteppe/sdmmagpie), Linux 4.14
# Consumed by halium-generic-adaptation-build-tools (see build.sh in this directory).
# Boot parameters taken from LineageOS android_device_xiaomi_{sweet,sm6150-common} (lineage-21).

deviceinfo_name="Redmi Note 10 Pro"
deviceinfo_manufacturer="Xiaomi"
deviceinfo_codename="sweetin"
deviceinfo_arch="aarch64"
deviceinfo_halium_version="11"

# Kernel: LineageOS tree, patched and configured by build.sh before the generic build runs
deviceinfo_kernel_source="https://github.com/LineageOS/android_kernel_xiaomi_sm6150"
deviceinfo_kernel_source_branch="lineage-21"
deviceinfo_kernel_defconfig="vendor/sdmsteppe-perf_defconfig vendor/debugfs.config vendor/sweet.config vendor/halium.config vendor/halium-checker.config"
deviceinfo_kernel_cmdline="console=ttyMSM0,115200n8 earlycon=msm_geni_serial,0x880000 androidboot.hardware=qcom androidboot.console=ttyMSM0 androidboot.usbcontroller=a600000.dwc3 androidboot.boot_devices=soc/1d84000.ufshc service_locator.enable=1 lpm_levels.sleep_disabled=1 loop.max_part=7 printk.devkmsg=on systempart=/dev/mapper/system"
deviceinfo_kernel_clang_compile="true"
deviceinfo_kernel_image_name="Image.gz"
deviceinfo_kernel_disable_modules="true"

# Boot image (LineageOS: header v2, base 0x0, page size 4096, DTB in boot image, separate DTBO)
deviceinfo_bootimg_header_version="2"
deviceinfo_flash_pagesize="4096"
deviceinfo_flash_offset_base="0x00000000"
deviceinfo_flash_offset_kernel="0x00008000"
deviceinfo_flash_offset_ramdisk="0x01000000"
deviceinfo_flash_offset_second="0x00000000"
deviceinfo_flash_offset_tags="0x00000100"
deviceinfo_flash_offset_dtb="0x01f00000"
deviceinfo_bootimg_os_version="11"
# Placeholder: copy the real value from your stock boot.img (unpack_bootimg.py). The header field is informational; AVB rollback uses vbmeta.
deviceinfo_bootimg_os_patch_level="2022-12-05"
deviceinfo_bootimg_partition_size="134217728"

deviceinfo_dtb="qcom/xiaomi-sdmmagpie.dtb"
deviceinfo_dtbo="qcom/sweet-sdmmagpie-overlay.dtbo"

# Partitions: A-only, dynamic partitions (super); Ubuntu Touch rootfs replaces the system partition
deviceinfo_system_partition_size="3584M"
deviceinfo_has_recovery_partition="false"
