# Xiaomi's Android build enables this when BOARD_KERNEL_SEPARATED_DTBO is set (it is not in sweet_user_defconfig, nor
# visible in the stock kernel's embedded config). It selects the base sdmmagpie.dtb + sweet-sdmmagpie-overlay.dtbo
# layout that the stock boot.img/dtbo partition use, instead of complete per-board trees.
CONFIG_BUILD_ARM64_DT_OVERLAY=y
